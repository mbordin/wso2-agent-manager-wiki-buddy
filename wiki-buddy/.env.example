# --- LLM ---
# Opzione A (consigliata con Agent Manager): AI Gateway di Agent Manager.
# Console > agente > Configure > LLM Configurations > OpenAI > "Connect to LLM Provider"
LLM_PROVIDER_URL=
LLM_PROVIDER_KEY=
LLM_API_KEY_HEADER=API-Key
# Opzione B (sviluppo locale, direttamente su OpenAI): lascia vuote le tre variabili sopra
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- MCP di terze parti ---
# DeepWiki (Cognition): MCP pubblico, senza autenticazione, documentazione di repo GitHub
MCP_URL=https://mcp.deepwiki.com/mcp
# Solo se l'MCP e' dietro un proxy di Agent Manager con API key
MCP_API_KEY=
MCP_API_KEY_HEADER=X-API-Key

# --- Osservabilita' Agent Manager (agente Externally-Hosted) ---
# Console > Setup Agent
AMP_OTEL_ENDPOINT=
AMP_AGENT_API_KEY=

PORT=8000
